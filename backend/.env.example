# Values for the env(...) references in the [auth] sections of
# supabase/config.toml.
#
# Local stack: from backend/, `cp .env.example supabase/.env` (git-ignored);
# the Supabase CLI reads it for `supabase start` and every other command.
# All four of WYRD_SITE_URL, SMTP_ENABLED, SMTP_PORT and WYRD_AUTH_GITHUB must
# have a value: true/false and numbers can't stay unresolved.
#
# Hosted project: the deploy exports the same names from the GitHub repository
# variables and secrets before `supabase config push`. Never commit real values.

# The web app's address. Local Flutter web: flutter run -d chrome --web-port 3000
WYRD_SITE_URL=http://localhost:3000

# Custom SMTP. false keeps local mail in the local inbox (http://127.0.0.1:54324);
# the deploy sets true. For example:
#   Brevo free:  smtp-relay.brevo.com, 587, the SMTP login shown by Brevo
#                (...@smtp-brevo.com) and an SMTP key; SMTP_ADMIN_EMAIL = a
#                sender address you verified in Brevo
#   Gmail:       smtp.gmail.com, 587, your address and an app password
#   Resend:      smtp.resend.com, 587, user "resend" and an API key (needs a domain)
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Wyrd

# GitHub OAuth app. true switches the provider on; app builds take the same
# flag as --dart-define=WYRD_AUTH_GITHUB=true to show the button. Locally it
# needs an OAuth app of its own whose callback URL is
# http://127.0.0.1:54321/auth/v1/callback.
WYRD_AUTH_GITHUB=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
