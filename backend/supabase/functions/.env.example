# Edge Function secrets for LOCAL development.
# Copy to backend/supabase/functions/.env (git-ignored) and fill in.
# In hosted projects set them with `supabase secrets set NAME=value`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# Anthropic API key. Leave empty to run every evaluation and chronicle
# through the deterministic heuristic / template (no AI calls at all).
ANTHROPIC_API_KEY=

# Model per route (operator decision; default claude-opus-5-5).
AI_EVALUATION_MODEL=claude-opus-5-5
AI_CHRONICLE_MODEL=claude-opus-5-5

# Server-side refusal fallback (`fallbacks: "default"`); "off" disables it.
AI_SERVER_FALLBACKS=on

# Google service-account JSON for FCM HTTP v1 (raw JSON or base64 of it).
# Empty: notify answers {"sent": false, "reason": "push_not_configured"}.
FCM_SERVICE_ACCOUNT=

# Optional shared secret for internal callers (header x-internal-secret),
# as an alternative to sending the service-role key.
INTERNAL_FUNCTION_SECRET=
